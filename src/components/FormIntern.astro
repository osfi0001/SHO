---
import Button from "./Button.astro"
---
<div class="bg-bg py-10">
<section class="border rounded-xl bg-white mx-10">

    <!--Grid-->
<div class="grid grid-cols-[1fr_2fr]">

<!--Header Section-->

<div class="bg-[url(public/BG15.png)] object-cover bg-center rounded-l-xl">
    <div class="px-6 py-20">
    <h1 class="body text-[64px] font-bold">BLIV PRAKTIKANT</h1>
    <div class="py-20 ">
    <p class="body py-4 text-[20px]">Søger du en stilling som frivillig istedet?</p>
    <Button title="BLIV FRIVILLIG" href="/frivillig" text="Frivillig"></Button>
</div>
</div>  
</div>

<!--Form Section-->
<div>
    <div class="px-6 py-20 text-black font-body">
<p>Vil du være praktikant på Studenterhus Odense?</p>

<p>Send os en motiveret ansøgning og CV på <span class="bg-[url(/BG15.png)] bg-clip-text text-transparent">info@studenterhus.dk</span> eller på nedenstående formular</p>
    <form class="flex flex-col gap-6">
<input type="text" name="" id="">
    </form>
</div>

</div>

</section>
</div>