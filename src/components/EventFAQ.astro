  <div class="collapse collapse-plus border-t-1 border-b-1 rounded-none border-black">
    <input type="radio" name="my-accordion-3" checked="checked" />
    <div class="collapse-title font-semibold">
      <img src="/tinderbox-logo.svg" alt="tinderbox logo" class="w-20 my-2">
