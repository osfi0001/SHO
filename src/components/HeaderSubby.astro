---
const { src } = Astro.props;
---

<!-- STICKY HEADER -->
<section
   style={`background-image: url('${src}');`}
  class="
    fixed top-0 left-0 w-full z-[100]
    h-[150px]
    bg-left bg-cover bg-no-repeat
  "
>

  <!-- Content -->
  <div class="absolute inset-0 flex items-center justify-between px-6">

    <!-- LOGO -->
    <div class="flex items-center">
      <a href="/">
        <img src="/sho_logo_black.svg" alt="Logo" class="h-20" />
      </a>
    </div>


    <!-- BURGER BUTTON (top-right) -->
    <label
  for="my-drawer"
  class="
    fixed top-14 lg:top-12 right-10
    z-[9999]
    cursor-pointer
    pointer-events-auto
  "
>
  <img class="h-6 lg:h-8" src="/open.svg" alt="open menu" />
</label>


    <!-- DRAWER SYSTEM -->
    <div class="drawer drawer-end">

      <input id="my-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content"></div>

      <!-- SIDE MENU -->
      <div class="drawer-side z-[200]">

        <label for="my-drawer" class="drawer-overlay"></label>

        <div
          class="
            min-h-full 
            w-full lg:w-1/3
            bg-cover bg-center bg-no-repeat
            bg-[url('/burgermenubg.png')]
            p-8
            text-white
            relative
          "
        >

          <ul class="mt-20 space-y-6 text-3xl font-semibold font-body text-(--color-text)">
            <li><a href="/" class="hover:opacity-70">Hjem</a></li>
            <li><a href="/about" class="hover:opacity-70">Om Os</a></li>
            <li><a href="/events" class="hover:opacity-70">Events</a></li>
            <li><a href="/volunteer" class="hover:opacity-70">Bliv Frivillig</a></li>
            <li><a href="/intern" class="hover:opacity-70">Bliv Praktikant</a></li>
            <li><a href="/aktuelle_stillinger" class="hover:opacity-70">Aktuelle Stillinger</a></li>
          </ul>

          <img
            class="absolute right-0 bottom-0 h-65 lg:h-70"
            src="/sho_drawing.svg"
            alt=""
          />

        </div>
      </div>
    </div>
  </div>
</section>
