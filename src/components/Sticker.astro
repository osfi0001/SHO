<!-- Popup Menu -->
<div
  id="popupMenu"
  class="fixed right-4 bottom-[100px] z-50
         translate-x-full opacity-0
         transition-all duration-300 ease-out
         shadow-xl rounded-xl p-6 w-56 bg-bg"
>
  <!-- Close button -->
  <button
      id="closePopup" 
      class="absolute top-2 right-2 text-gray-400 hover:text-black cursor-pointer"
  >
    ✕
  </button>

  <!-- Menu links -->
  <nav class="flex flex-col gap-4 mt-4 text-text font-body font-bold">
    <a href="/events" class="hover:underline">SE EVENTS</a>
    <a href="/volunteer" class="hover:underline">BLIV FRIVILLIG</a>
    <a href="/intern" class="hover:underline">BLIV PRAKTIKANT</a>
  </nav>
</div>

<!-- ✅ Reopen button MUST be OUTSIDE popup -->
<button
  id="openPopup"
  class="fixed right-4 bottom-[160px] z-40
         hidden
        text-text font-body font-bold
         px-4 py-2
         transition hover:scale-115 cursor-pointer"
>
  <img class="w-5 rotate-180" src="/arrow.svg" alt="">
</button>

<script>
    const menu = document.getElementById("popupMenu");
    const openBtn = document.getElementById("openPopup");
    const closeBtn = document.getElementById("closePopup");
  
    function openMenu() {
      menu.classList.remove("translate-x-full", "opacity-0");
      menu.classList.add("translate-x-0", "opacity-100");
      openBtn.classList.add("hidden");
    }
  
    function closeMenu() {
      menu.classList.add("translate-x-full", "opacity-0");
      openBtn.classList.remove("hidden");
    }
  
    window.addEventListener("load", openMenu);
    closeBtn.addEventListener("click", closeMenu);
    openBtn.addEventListener("click", openMenu);
  </script>
  